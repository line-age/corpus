        <mxCell id="8wzZVlfVUSbkhHeznFRO-18" parent="1" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;" value="&lt;b&gt;Questions to Answer:&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;- what format is the data? text, image, video?&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;- Is there an API?&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;- Does a single document contain every metadata needed?&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="200" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="8wzZVlfVUSbkhHeznFRO-19" edge="1" parent="1" source="8wzZVlfVUSbkhHeznFRO-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.508;entryY=0.8;entryDx=0;entryDy=0;entryPerimeter=0;defaultLabelBackgroundColor=page;" target="8wzZVlfVUSbkhHeznFRO-18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="8wzZVlfVUSbkhHeznFRO-20" parent="1" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;" value="&lt;b&gt;Questions to Answer:&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b&gt;- &lt;/b&gt;What is the minimum setup required for an MVP? Airflow, Docker for development, DB for configs &amp;amp; tracking data&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;- What is the architecture and flow&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;- Spike: A basic CSV dump of a small dataset to show what the final output would look like?&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="390" x="260" y="15" as="geometry" />
        </mxCell>
        <mxCell id="8wzZVlfVUSbkhHeznFRO-22" parent="1" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;- Is vectorisation needed at this stage, or would keyword search be sufficient? POC needed&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;- Establish a gold set&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="290" x="525" y="400" as="geometry" />
        </mxCell>
        <mxCell id="8wzZVlfVUSbkhHeznFRO-25" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 8px;&quot;&gt;Archive.org API&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="200" y="200" as="geometry" />
        </mxCell>
        <mxCell id="8wzZVlfVUSbkhHeznFRO-27" parent="1" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;First issues (POC state)&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;1. POC data ingestion: internal data archive aka content_raw_data lake, batch transformation into cleaned data&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;2. POC search API: keyword-based search on transformed data&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;3. Set up database model - tables, metadata, initial database capacity, where does data live&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;4. POC infra setup: Docker, CI/CD, capacity estimation (drawn from average size of publication)&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;Delivery Timelines:&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;Nb:&amp;nbsp;&lt;/div&gt;" vertex="1">
