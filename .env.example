# Local configuration for docker compose. `make` copies this to .env on first use.
# .env is gitignored; never commit it. Every value here has a default in
# src/corpus/config.py, except API_PORT and FORWARD_API_PORT, which the app never
# reads: compose reads both, and the container's uvicorn command reads API_PORT.

# API
DOCS_ENABLED=true
HEALTHZ_TIMEOUT_SECONDS=3
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
# Port uvicorn listens on inside the container.
API_PORT=9001
# Host port compose publishes the API on, forwarding to API_PORT.
FORWARD_API_PORT=9001

# Postgres. The database container reads the same variables, so the API and the
# database always agree. Changing the password after the volume exists has no effect
# on the database; `docker compose down -v` resets it (and deletes its data).
POSTGRES_HOST=corpus-db
POSTGRES_PORT=5432
POSTGRES_USER=corpus
POSTGRES_PASSWORD=corpus
POSTGRES_DB=corpus
POSTGRES_CONNECT_TIMEOUT=5
# Connection pool, per API process. MAX_CONNECTIONS includes the POOL_SIZE connections
# kept open; the rest open under load and close when idle.
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_CONNECTIONS=10
